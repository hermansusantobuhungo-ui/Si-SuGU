rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is logged in
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper to get user document
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Role checkers
    function isAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'admin' ||
        request.auth.token.role == 'admin'
      );
    }

    function isKamad() {
      return isAuthenticated() && (
        getUserData().role == 'kamad' ||
        request.auth.token.role == 'kamad'
      );
    }

    function isPenilai() {
      return isAuthenticated() && (
        getUserData().role == 'penilai' ||
        request.auth.token.role == 'penilai'
      );
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Teaching Documents collection
    match /teachingDocuments/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Supervision Schedules collection
    match /supervisionSchedules/{schedId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Admin Supervision Assessments
    match /adminAssessments/{assessId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Teaching Supervision Assessments (Observasi Mengajar)
    match /teachingAssessments/{assessId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Follow Up Plans (RTL)
    match /followUpPlans/{planId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // App Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Audit Logs collection
    match /auditLogs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }
  }
}
